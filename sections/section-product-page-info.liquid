{{ 'section-product-page-info.css' |  asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }} ">
  <div class="page-width" style="max-width: 1300px;">
    <h1 class="product__info-section-header">{{ section.settings.header }}</h1>

    <div class="product__info-wrapper">
      {% for block in section.blocks %} 
        {%  case block.type %} 
          {% when 'product_value_point' %}
            <div class="product__value-point-wrapper">
              <h2>{% render 'icon-tick-2' %} {{ block.settings.title }}</h2>
              {{ block.settings.description }}
            </div>
        {% endcase %} 
      {% endfor %}

    </div>

  </div>
</div>




{%  schema  %} 
  {
   "name": "Product Page Info",
   "tag": "section",
   "class": "section",
   "settings": [
     {
       "type": "color_scheme",
       "id": "color_scheme",
       "label": "t:sections.all.colors.label",
       "default": "scheme-1"
     },
     {
       "type": "inline_richtext",
       "id": "header",
       "label": "Section Header",
       "default": "Header"
     },
     {
       "type": "header",
       "content": "t:sections.all.padding.section_padding_heading"
     },
     {
       "type": "range",
       "id": "padding_top",
       "min": 0,
       "max": 100,
       "step": 4,
       "unit": "px",
       "label": "t:sections.all.padding.padding_top",
       "default": 36
     },
     {
       "type": "range",
       "id": "padding_bottom",
       "min": 0,
       "max": 100,
       "step": 4,
       "unit": "px",
       "label": "t:sections.all.padding.padding_bottom",
       "default": 36
     }
   ],
   "blocks": [
    {
      "name": "Product Value Point",
      "type": "product_value_point",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Lorem ipsum dolor sit amet "
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Lorem ipsum dolor sit amet consectetur. Id purus cras sed habitasse tortor nec risus. In vel scelerisque aliquet mauris! Molestie tempus pulvinar amet et vitae consequat convallis amet at. Ultrices urna!</p>"
        }
      ]
    }
   ],
   "presets": [
    {
      "name": "Product Page Info"
    }
   ]
  }
 {% endschema %} 