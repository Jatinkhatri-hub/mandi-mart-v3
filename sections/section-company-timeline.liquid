{{ 'section-company-timeline.css' |  asset_url |  stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width" style="max-width: 1300px;">

    <div class="timeline-container">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'timeline_point' %}
            <div class="timeline-item">
              <div class="timeline-point"></div>
              <div class="timeline-content">
                  <h2 class="timeline__year">{{ block.settings.year }}</h2>
                  <h3 class="timeline__title">{{ block.settings.title }}</h3>
                  <p class="timeline__description">{{ block.settings.description }}</p>
              </div>
              <div class="timeline-image">
                  <img src="{{ block.settings.image |  image_url: width: block.settings.test_img.image.width }}" alt="Event 1 Image">
              </div>
          </div>

           
        {% endcase %}
      {% endfor %}
    </div>  
  </div>
    {% comment %} <div class="timeline">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'timeline_point' %}
            <div class="timeline-item">
              <div class="timeline-point"></div>
              <div class="timeline-content">
                  <h2 class="timeline__year">1999</h2>
                  <h3 class="timeline__title">Sam is diagnosed with Autism.</h3>
                  <p class="timeline__description">Lorem ipsum dolor sit amet consectetur. Bibendum placerat ornare erat interdum nisl. Sed leo felis quam eu consequat. Sit varius blandit turpis tempus magna velit euismod proin viverra. Amet sapien duis interdum ante elit elementum ultrices. <br><br>
                    Molestie tempus pulvinar amet et vitae consequat convallis amet at. Ultrices urna fermentum malesuada arcu viverra neque dui malesuada. Libero faucibus quis at fringilla.<br><br>
                    Sed leo felis quam eu consequat. Sit varius blandit turpis tempus magna velit euismod proin viverra. Amet sapien duis interdum ante elit elementum ultrices.</p>
              </div>
              <div class="timeline-image">
                  <img src="{{ section.settings.test_img |  image_url: width: section.settings.test_img.width }}" alt="Event 1 Image">
              </div>
          </div>

           
        {% endcase %}
      {% endfor %}
    </div> {% endcomment %}
    {%  comment  %}     
      <div class="company-timeline">
        <div class="company-timeline__line">
        </div>
        {% for block in section.blocks %}
          {%  case block.type %}
            {% when 'timeline_point' %} 
              <div class="timeline-point" style="top: 10%;"></div>
              <div class="timeline-item right">
                  <div class="timeline-content">
                      <h2>{{ block.settings.year }}</h2>
                      <h3>{{ block.settings.title }}</h3>
                      <p>{{ block.settings.description }}</p>
                  </div>
                  <img src="{{ block.settings.image |  image_url: width: block.settings.image.width }}" alt="First Event" class="timeline-image">
              </div>
          
          {% endcase %} 
        {% endfor %}
      </div>
    {% endcomment %} 
  </div>
</div>

<script>
  // Optional: Add JavaScript for additional interactivity if needed
  document.addEventListener('DOMContentLoaded', function() {
      // You can add scroll animations or other interactive features here
      const timelineItems = document.querySelectorAll('.timeline-item');

      // Simple fade-in animation on scroll
      const observerOptions = {
          threshold: 0.1
      };

      const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
              if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
              }
          });
      }, observerOptions);

      timelineItems.forEach(item => {
          observer.observe(item);
      });
  });
</script>

{%  schema  %} 
{
  "name": "Company Timeline",
  "settings": [
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "image_picker",
      "id": "test_img",
      "label": "Test Image"
    }    
  ],
  "blocks": [
    {
      "name": "Timeline Point",
      "type": "timeline_point",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "year",
          "label": "Year"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet consectetur. Vitae vivamus nullam pharetra maecenas elementum ultricies faucibus!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Company Timeline"
    }
  ]
} 
{% endschema %} 