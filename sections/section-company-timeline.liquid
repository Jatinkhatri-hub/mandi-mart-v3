{{ 'section-company-timeline.css' |  asset_url |  stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="company-timeline">
      <div class="company-timeline__line">
      </div>
      {% for block in section.blocks %}
        {%  case block %} 
          <div class="timeline-point" style="top: 10%;"></div>
          <div class="timeline-item left">
              <div class="timeline-content">
                  <h3>First Event</h3>
                  <p>Description of the first important event in the timeline.</p>
              </div>
              <img src="/api/placeholder/200/200" alt="First Event" class="timeline-image">
          </div>
        
        {% endcase %} 
      {% endfor %}
    </div>
  </div>
</div>

{%  schema  %} 
{
  "name": "Company Timeline",
  "settings": [
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }    
  ],
  "blocks": [
    {
      "name": "Timeline Point",
      "type": "timeline_point",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "year",
          "label": "Year"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet consectetur. Vitae vivamus nullam pharetra maecenas elementum ultricies faucibus!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Company Timeline"
    }
  ]
} 
{% endschema %} 