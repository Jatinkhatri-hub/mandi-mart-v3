{{ 'section-company-timeline.css' |  asset_url |  stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width" style="max-width: 1300px;">

    <div class="timeline-container">
      <div class="timeline-item">
          <div class="timeline-point"></div>
          <div class="timeline-content">
              <h3>Event Title 1</h3>
              <p>Description of the first event goes here. This is where you'll provide details about a specific milestone or important moment.</p>
          </div>
          <div class="timeline-image">
              <img src="{{ section.settings }}" alt="Event 1 Image">
          </div>
      </div>

      <div class="timeline-item">
          <div class="timeline-point"></div>
          <div class="timeline-content">
              <h3>Event Title 2</h3>
              <p>Description of the second event goes here. Add more information about the significant event or achievement.</p>
          </div>
          <div class="timeline-image">
              <img src="/api/placeholder/400/300" alt="Event 2 Image">
          </div>
      </div>

      <div class="timeline-item">
          <div class="timeline-point"></div>
          <div class="timeline-content">
              <h3>Event Title 3</h3>
              <p>Description of the third event goes here. Provide context and details about this important moment.</p>
          </div>
          <div class="timeline-image">
              <img src="/api/placeholder/400/300" alt="Event 3 Image">
          </div>
      </div>
  </div>
    {% comment %} <div class="timeline">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'timeline_point' %}
            <div class="container right">
              <div class="content">
                <h2 class="timeline__year">{{ block.settings.year }}</h2>
                <h2 class="timeline__title">{{ block.settings.title }}</h2>
                <p class="timeline__description">{{ block.settings.description }}</p>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div> {% endcomment %}
    {%  comment  %}     
      <div class="company-timeline">
        <div class="company-timeline__line">
        </div>
        {% for block in section.blocks %}
          {%  case block.type %}
            {% when 'timeline_point' %} 
              <div class="timeline-point" style="top: 10%;"></div>
              <div class="timeline-item right">
                  <div class="timeline-content">
                      <h2>{{ block.settings.year }}</h2>
                      <h3>{{ block.settings.title }}</h3>
                      <p>{{ block.settings.description }}</p>
                  </div>
                  <img src="{{ block.settings.image |  image_url: width: block.settings.image.width }}" alt="First Event" class="timeline-image">
              </div>
          
          {% endcase %} 
        {% endfor %}
      </div>
    {% endcomment %} 
  </div>
</div>

{% comment %} <script>
  document.addEventListener('DOMContentLoaded', () => {
      const timelineItems = document.querySelectorAll('.timeline-item');
      const timelinePoints = document.querySelectorAll('.timeline-point');

      const revealOnScroll = () => {
          const triggerBottom = window.innerHeight * 0.8;

          timelineItems.forEach((item, index) => {
              const itemTop = item.getBoundingClientRect().top;
              const point = timelinePoints[index];

              if (itemTop < triggerBottom) {
                  item.classList.add('reveal');
                  point.classList.add('active');
              } else {
                  item.classList.remove('reveal');
                  point.classList.remove('active');
              }
          });
      };

      window.addEventListener('scroll', revealOnScroll);
      revealOnScroll(); // Trigger initial check
  });
</script> {% endcomment %}

{%  schema  %} 
{
  "name": "Company Timeline",
  "settings": [
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "image_picker",
      "id": "test_img",
      "label": "Test Image"
    }    
  ],
  "blocks": [
    {
      "name": "Timeline Point",
      "type": "timeline_point",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "year",
          "label": "Year"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet consectetur. Vitae vivamus nullam pharetra maecenas elementum ultricies faucibus!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Company Timeline"
    }
  ]
} 
{% endschema %} 